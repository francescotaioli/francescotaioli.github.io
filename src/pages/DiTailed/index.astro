    </div>

    <!-- Hero -->
    <header class="hero fade-in" id="top">
        <div class="venue-badge">ECCV 2026</div>
        <h1><span>DiTailed:</span> Ensuring Visual Object Consistency in Text-Image-to-Image Flow Matching Models</h1>
        
        <div class="authors">
            <span>Francesco Taioli<span class="affiliation">1</span></span>
            <span>Daniel Coelho<span class="affiliation">1</span></span>
            <span>Iaroslav Melekhov<span class="affiliation">1</span></span>
            <span>Roberto Alcover-Couso<span class="affiliation">1</span></span>
            <span>Jose Miguel Grande Saiz<span class="affiliation">1</span></span>
