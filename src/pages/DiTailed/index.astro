<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>DiTailed: Ensuring Visual Object Consistency in Text-Image-to-Image Flow Matching Models</title>
    <meta name="description" content="DiTailed introduces ABO-Edit, a 12k+ triplet benchmark, and FlowMirror, a parameter-free auxiliary loss that improves visual object consistency in rectified flow image editing models. ECCV 2026.">
    <meta property="og:title" content="DiTailed: Visual Object Consistency in Flow Matching Models">
    <meta property="og:description" content="A parameter-free auxiliary loss for improving object consistency in text-image-to-image editing. ECCV 2026.">
    <meta property="og:type" content="website">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
    <style is:inline>
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

        :root {
            --c-bg: #fafafa;
            --c-surface: #ffffff;
            --c-text: #1a1a2e;
            --c-text-secondary: #4a4a6a;
            --c-accent: #2563eb;
            --c-accent-soft: #dbeafe;
            --c-border: #e5e7eb;
            --c-badge: #bbf7d0;
            --c-badge-text: #166534;
            --c-badge-border: #4ade80;
            --c-nav-bg: rgba(250, 250, 250, 0.85);
            --font-sans: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
            --font-mono: 'JetBrains Mono', monospace;
            --max-w: 1100px;
            --section-gap: 3rem;
        }

        .dark {
            --c-bg: #1c1c2e;
            --c-surface: #262640;
            --c-text: #e8e8f0;
            --c-text-secondary: #a0a0c0;
            --c-accent: #60a5fa;
            --c-accent-soft: #1e3a5f;
            --c-border: #363650;
            --c-badge: #052e16;
            --c-badge-text: #86efac;
            --c-badge-border: #22c55e;
            --c-nav-bg: rgba(28, 28, 46, 0.85);
        }

        html { scroll-behavior: smooth; }

        body {
            font-family: var(--font-sans);
            background: var(--c-bg);
            color: var(--c-text);
            line-height: 1.7;
            -webkit-font-smoothing: antialiased;
            -moz-osx-font-smoothing: grayscale;
        }

        /* Navigation */
        .top-nav {
            position: sticky;
            top: 0;
            z-index: 100;
            background: var(--c-nav-bg);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border-bottom: 1px solid var(--c-border);
            padding: 0 1.5rem;
        }

        .nav-inner {
            max-width: var(--max-w);
            margin: 0 auto;
            display: flex;
            align-items: center;
            justify-content: space-between;
            height: 3.2rem;
        }

        .nav-brand {
            font-weight: 700;
            font-size: 0.9rem;
            color: var(--c-text);
            text-decoration: none;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .nav-brand img {
            height: 22px;
            width: auto;
        }

        .nav-links {
            display: flex;
            align-items: center;
            gap: 0.2rem;
            list-style: none;
            overflow-x: auto;
        }

        .nav-links a {
            font-size: 0.78rem;
            font-weight: 500;
            color: var(--c-text-secondary);
            text-decoration: none;
            padding: 0.4rem 0.65rem;
            border-radius: 6px;
            transition: color 0.2s, background 0.2s;
            white-space: nowrap;
        }

        .nav-links a:hover {
            color: var(--c-accent);
            background: var(--c-accent-soft);
        }

        .theme-toggle {
            background: none;
            border: 1px solid var(--c-border);
            border-radius: 8px;
            width: 34px;
            height: 34px;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--c-text-secondary);
            transition: color 0.2s, border-color 0.2s;
            flex-shrink: 0;
            margin-left: 0.5rem;
        }

        .theme-toggle:hover {
            color: var(--c-accent);
            border-color: var(--c-accent);
        }

        .theme-toggle svg {
            width: 18px;
            height: 18px;
        }

        .icon-sun, .icon-moon { display: none; }
        .dark .icon-moon { display: block; }
        .dark .icon-sun { display: none; }
        :not(.dark) .icon-sun { display: block; }
        :not(.dark) .icon-moon { display: none; }

        /* Hero */
        .hero {
            padding: 4rem 1.5rem 3rem;
            text-align: center;
            max-width: var(--max-w);
            margin: 0 auto;
        }

        .venue-badge {
            display: inline-block;
            background: var(--c-badge);
            color: var(--c-badge-text);
            border: 1.5px solid var(--c-badge-border);
            font-size: 1rem;
            font-weight: 600;
            padding: 0.35rem 0.9rem;
            border-radius: 100px;
            letter-spacing: 0.04em;
            margin-bottom: 1.5rem;
            text-transform: uppercase;
        }

        .hero h1 {
            font-size: clamp(1.6rem, 4vw, 2.8rem);
            font-weight: 700;
            line-height: 1.2;
            margin-bottom: 0.5rem;
            letter-spacing: -0.02em;
        }

        .hero h1 span {
            color: var(--c-accent);
        }

        .subtitle {
            font-size: clamp(1rem, 2vw, 1.2rem);
            color: var(--c-text-secondary);
            max-width: 720px;
            margin: 0.8rem auto 0;
            font-weight: 400;
        }

        /* Authors */
        .authors {
            margin-top: 2rem;
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            gap: 0.3rem 1.2rem;
            font-size: 0.95rem;
        }

        .authors span {
            white-space: nowrap;
        }

        .authors .affiliation {
            font-size: 0.82rem;
            color: var(--c-text-secondary);
            vertical-align: super;
            font-weight: 500;
        }

        .affiliations-list {
            margin-top: 1.5rem;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-wrap: wrap;
            gap: 0.6rem;
        }

        .affiliation-item {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            font-size: 0.85rem;
            color: var(--c-text);
            font-weight: 500;
            padding: 0.45rem 1rem;
            border-radius: 100px;
            border: 1px solid var(--c-border);
            background: var(--c-surface);
            transition: border-color 0.2s;
        }

        .affiliation-item:hover {
            border-color: var(--c-accent);
        }

        a.affiliation-item {
            text-decoration: none;
            cursor: pointer;
        }

        button.affiliation-item {
            cursor: pointer;
            font-family: inherit;
        }

        .affiliation-sep {
            width: 1px;
            height: 24px;
            background: var(--c-border);
            margin: 0 0.25rem;
        }

        .affiliation-item img {
            height: 20px;
            width: auto;
            object-fit: contain;
        }

        .affiliation-item sup {
            font-size: 0.65rem;
            margin-right: -0.1rem;
            color: var(--c-text-secondary);
        }

        /* Links bar */
        .links-bar {
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            gap: 0.75rem;
            margin-top: 2rem;
        }

        .link-btn {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            padding: 0.6rem 1.2rem;
            border-radius: 8px;
            font-size: 0.88rem;
            font-weight: 500;
            text-decoration: none;
            transition: all 0.2s ease;
            border: 1px solid var(--c-border);
            color: var(--c-text);
            background: var(--c-surface);
        }

        .link-btn:hover {
            border-color: var(--c-accent);
            color: var(--c-accent);
            transform: translateY(-1px);
            box-shadow: 0 4px 12px rgba(37, 99, 235, 0.1);
        }

        .link-btn svg {
            width: 18px;
            height: 18px;
            flex-shrink: 0;
        }

        /* Sections */
        section {
            max-width: var(--max-w);
            margin: 0 auto;
            padding: 0 1.5rem;
            margin-bottom: var(--section-gap);
        }

        .section-label {
            font-size: 0.75rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.1em;
            color: var(--c-accent);
            margin-bottom: 0.6rem;
        }

        section h2 {
            font-size: clamp(1.3rem, 3vw, 1.9rem);
            font-weight: 700;
            margin-bottom: 1rem;
            letter-spacing: -0.01em;
        }

        section p {
            color: var(--c-text-secondary);
            font-size: 1rem;
        }

        /* Figures */
        .figure-container {
            margin: 2rem 0;
            border-radius: 12px;
            overflow: hidden;
            border: 1px solid var(--c-border);
            background: var(--c-surface);
        }

        .figure-container img {
            width: 100%;
            height: auto;
            display: block;
        }

        .figure-caption {
            padding: 1rem 1.25rem;
            font-size: 0.85rem;
            color: var(--c-text-secondary);
            border-top: 1px solid var(--c-border);
            line-height: 1.5;
        }

        .figure-caption strong {
            color: var(--c-text);
        }

        /* Full-width figure variant */
        .figure-wide {
            max-width: 1200px;
            margin-left: auto;
            margin-right: auto;
        }

        /* Key findings cards */
        .findings-grid {
            display: grid;
            grid-template-columns: 1fr;
            gap: 1.25rem;
            margin-top: 1.5rem;
        }

        @media (min-width: 640px) {
            .findings-grid {
                grid-template-columns: 1fr 1fr 1fr;
            }
        }

        .finding-card {
            background: var(--c-surface);
            border: 1px solid var(--c-border);
            border-radius: 12px;
            padding: 1.5rem;
            transition: border-color 0.2s;
        }

        .finding-card:hover {
            border-color: var(--c-accent);
        }

        .finding-card .number {
            font-size: 0.75rem;
            font-weight: 700;
            color: var(--c-accent);
            letter-spacing: 0.05em;
            text-transform: uppercase;
            margin-bottom: 0.5rem;
        }

        .finding-card h3 {
            font-size: 1rem;
            font-weight: 600;
            margin-bottom: 0.5rem;
            line-height: 1.3;
        }

        .finding-card p {
            font-size: 0.88rem;
            color: var(--c-text-secondary);
            line-height: 1.5;
        }

        .card-link {
            display: inline-block;
            margin-top: 0.75rem;
            font-size: 0.8rem;
            font-weight: 600;
            color: var(--c-accent);
            text-decoration: none;
            transition: opacity 0.2s;
        }

        .card-link:hover {
            opacity: 0.7;
        }

        /* Results table */
        .table-wrapper {
            overflow-x: auto;
            margin: 1.5rem 0;
            border-radius: 12px;
            border: 1px solid var(--c-border);
            background: var(--c-surface);
        }

        table {
            width: 100%;
            border-collapse: collapse;
            font-size: 0.85rem;
            white-space: nowrap;
        }

        thead {
            background: var(--c-bg);
        }

        th {
            padding: 0.9rem 1rem;
            font-weight: 600;
            text-align: left;
            font-size: 0.78rem;
            text-transform: uppercase;
            letter-spacing: 0.04em;
            color: var(--c-text-secondary);
            border-bottom: 1px solid var(--c-border);
        }

        td {
            padding: 0.75rem 1rem;
            border-bottom: 1px solid var(--c-border);
            font-family: var(--font-mono);
            font-size: 0.82rem;
        }

        tr:last-child td { border-bottom: none; }

        .row-highlight {
            background: var(--c-accent-soft);
        }

        .row-highlight td {
            font-weight: 600;
        }

        td.method-name {
            font-family: var(--font-sans);
            font-weight: 500;
        }

        .table-section-header td {
            font-family: var(--font-sans);
            font-weight: 600;
            font-size: 0.8rem;
            color: var(--c-text-secondary);
            padding-top: 1rem;
            border-bottom: none;
            font-style: italic;
        }

        /* Abstract / TLDR */
        .tldr {
            background: var(--c-surface);
            border: 1px solid var(--c-border);
            border-left: 3px solid var(--c-accent);
            border-radius: 8px;
            padding: 1.5rem;
            margin-top: 1.5rem;
        }

        .tldr p {
            max-width: none;
            font-size: 0.95rem;
        }

        /* BibTeX */
        .bibtex-block {
            background: var(--c-surface);
            border: 1px solid var(--c-border);
            border-radius: 8px;
            padding: 1.25rem;
            margin-top: 1rem;
            position: relative;
            overflow-x: auto;
        }

        .bibtex-block pre {
            font-family: var(--font-mono);
            font-size: 0.78rem;
            line-height: 1.6;
            color: var(--c-text-secondary);
            margin: 0;
        }

        .copy-btn {
            position: absolute;
            top: 0.75rem;
            right: 0.75rem;
            background: var(--c-bg);
            border: 1px solid var(--c-border);
            border-radius: 6px;
            padding: 0.4rem 0.6rem;
            cursor: pointer;
            font-size: 0.72rem;
            font-weight: 500;
            color: var(--c-text-secondary);
            transition: all 0.2s;
        }

        .copy-btn:hover {
            color: var(--c-accent);
            border-color: var(--c-accent);
        }

        /* Divider */
        .divider {
            border: none;
            height: 1px;
            background: var(--c-border);
            max-width: var(--max-w);
            margin: var(--section-gap) auto;
        }

        /* Footer */
        .page-footer {
            text-align: center;
            padding: 2rem 1.5rem 3rem;
            font-size: 0.82rem;
            color: var(--c-text-secondary);
            max-width: var(--max-w);
            margin: 0 auto;
        }

        /* Animations */
        @media (prefers-reduced-motion: no-preference) {
            .fade-in {
                opacity: 0;
                transform: translateY(16px);
                animation: fadeUp 0.6s ease forwards;
            }

            @keyframes fadeUp {
                to { opacity: 1; transform: translateY(0); }
            }

            .fade-in:nth-child(2) { animation-delay: 0.1s; }
            .fade-in:nth-child(3) { animation-delay: 0.2s; }
            .fade-in:nth-child(4) { animation-delay: 0.3s; }
        }

        /* Mobile menu */
        .mobile-menu-btn {
            display: none;
            background: none;
            border: 1px solid var(--c-border);
            border-radius: 8px;
            width: 34px;
            height: 34px;
            cursor: pointer;
            align-items: center;
            justify-content: center;
            color: var(--c-text-secondary);
            margin-left: 0.5rem;
        }

        .mobile-menu-btn svg {
            width: 18px;
            height: 18px;
        }

        .mobile-nav {
            display: none;
            position: fixed;
            top: 3.2rem;
            left: 0;
            right: 0;
            background: var(--c-nav-bg);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border-bottom: 1px solid var(--c-border);
            padding: 0.75rem 1.5rem;
            z-index: 99;
            flex-direction: column;
            gap: 0.25rem;
        }

        .mobile-nav.open {
            display: flex;
        }

        .mobile-nav a {
            font-size: 0.85rem;
            font-weight: 500;
            color: var(--c-text-secondary);
            text-decoration: none;
            padding: 0.5rem 0.75rem;
            border-radius: 6px;
            transition: color 0.2s, background 0.2s;
        }

        .mobile-nav a:hover {
            color: var(--c-accent);
            background: var(--c-accent-soft);
        }

        /* Responsive */
        @media (max-width: 768px) {
            :root { --section-gap: 2.5rem; }
            .hero { padding-top: 2.5rem; }
            .authors { font-size: 0.88rem; }
            .nav-links { display: none; }
            .mobile-menu-btn { display: flex; }
            .affiliation-sep { display: none; }
        }
    </style>
</head>
<body>
    <!-- Sticky Navigation -->
