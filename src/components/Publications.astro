<section id="publications" class="py-3 flex flex-col md:flex-row gap-8">
  <div class="md:w-1/4 flex-shrink-0">
    <h2 class="text-muted-text dark:text-dark-muted-text text-lg font-bold">
      Publications
    </h2>
  </div>
  <div class="md:w-3/4">
    <div class="grid gap-6">
      {publications.map((pub) => (
        <article class="group">
          {pub.image && (
            <img 
              src={pub.image} 
              alt={pub.title}
              class="w-full rounded-lg mb-4"
            />
          )}
          <h3 class="font-semibold mb-2 group-hover:text-muted-text dark:group-hover:text-dark-muted-text transition-colors">
            {pub.title}
          </h3>
          <p class="text-sm mb-2" set:html={pub.authors}></p>
          <p class="prose text-sm italic mb-3">{pub.venue}</p>
          {pub.links && (
            <div class="flex gap-3 mt-3">
              {pub.links.website && (
                <a href={pub.links.website} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 px-3 py-1.5 text-sm rounded-md bg-muted-text/5 dark:bg-dark-muted-text/5 text-muted-text dark:text-dark-muted-text hover:bg-muted-text/10 dark:hover:bg-dark-muted-text/10 transition-colors" aria-label="Project Website">
