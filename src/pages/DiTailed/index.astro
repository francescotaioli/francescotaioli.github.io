            <sup>1</sup>{'{'}ftaioli,dfcoelho,imlkhv,ralcover,jgrande,virfer{'}'}@amazon.com<br>
            <sup>2</sup>artur.bekasov@faculty.ai
        </p>
        <div class="affiliations-list">
            <div class="affiliation-item">
                <img src="/az.png" alt="Amazon logo">
                <span><sup>1</sup> <strong>Amazon</strong></span>
            </div>
            <div class="affiliation-item">
